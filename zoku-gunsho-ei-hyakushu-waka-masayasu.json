  {
   "seq": "11",
   "text": "一空になけは沢辺にのかふひはり毛のこまほしとのみ子や思はん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雲雀",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "玉章を生れにみへしとおもひ羽のそれもかすみて房ひゆくなん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "帰雁幽",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "いさそしるあかぬは人のひとも暮やらぬ日をおほしたひつく",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春日遅々",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "よしの山岡にそみゆる人かほみこゝろの色のこきも薄も",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "一立田川岑の春風吹ぬらしはなのうき浪たらぬ日もなき",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河花",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "春はたゝかくこそ有けれ山風のひさはかすはなの頃かな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花時不閑",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "桜にはおよはすかからことのはす此神かきの図によりなむ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花手向",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "散もそし風の尊の名にしかはゝこのからかきの花によりなん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落花",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "としあれは松もちからやよはるらん老木はふちにかゝるとそみる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "藤",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "身につもる日数そつらき花鳥の色年計に立とふとや思ふ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮春",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "世の中の人のいゝろかなつ衣うつろひやすくけふかへてけり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "更衣",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "うつ木ほら花に敷けり沓の跡もますかにみへぬけさのしら雪",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "路卯花",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "隔なくけふハかけゝり二葉草三は四はのやともかはらす",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "葵",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "ほとゝきにいつちなるらん山彦のこたふる山はそことしれとも",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "郭公何方",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "舟よするかひの雫もをちかへりいそのうきねに啼ほとゝさす",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "磯郭公",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "いとまなくおりたつ田子のあし玉も手玉もゆらにとるさかへかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早苗",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "たちはなのにほひそなのる神垣に立さふきねか袖のむかしを",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "社預橘",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "日をふれは濁るまゝにて鷹川渕瀬もみへぬさみたれの書",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "ほとやなき夏のよすからみる月も秋の一時のかけにくらへて",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏月易明",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "なにゝさてうるほふ色に雨も露も露もらしとはかりしけ取草",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏草",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "夏むしにあらぬ小鹿もともしすと身をいたつらになす思ひかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "照射",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "かゝき火はう舟のたなははてはまたくるしき海に漕や出まし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鵜河",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "とも吹火はおのか物から行かへり空にほたるのまよふ影かな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "金",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "風さはきはは所に音してふり来ぬもかねて涼しき夕立のぬ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕立",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "松かけに夏なきのみか閨をさへわすれてあかす夜半のみしかき",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "納涼し夏",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "一いつくにか中やとりして秋風の身にしむものとけさかはるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早秋朝",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "かならすとたのむ契やあやくとおもはてわたる難の橋",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕言志",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "秋の草供いつれと分てふかねとも秋音する萩のうむ風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "おく露潰炎さかのとしりなからあたにもなひしをみなへし哉",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "女郎花",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "なほさり潰家こそあらめ一本法尾岡か袖にいかゝつゝまむ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "薄薄",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "こゝろ有てたれみま草にけるかやをのこして秋の風を呑らん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "折茎乱風",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "とはゝやな露の限のあたしのになれはをいつをるまつむしの鳴",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野虫",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "〽みねこゆる房のすかたはかくらくのはつせの核はら声計して",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "終初雁",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "一春日秋法音をなく鹿はかのかつまつれなかれとや神もいさむる",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鹿",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "あやにくになかめくれけりおもはしになけかしとすれは秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋夕情",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "かりはてふ時にそおもふ秋の田潰いなおふせるにおふせてしかな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋田",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "夜半の月雲をさまりて弓張のいるとことおそき山のはの空",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "上絃月",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "あかすみてかへるもみちの錦木に立なからやは月の待へき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "立侍同",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "月やしますむ影はかりいにしへにかはらすなからあつなる世を",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "同似古",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "なけしそよつひに心にみかきゑす六十に近き月はみれとも",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "老人判月",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "山かつらひに有てしたへとも入なむとするまとの月かけ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁臆月",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "夏の夜にかきるものかは秋もなほねぬに明ぬと衣うつなり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "抜衣",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "けふことにつむとはすれと菊の歌わか世のうちも渕とやならん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "菊",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "たつた姫歌のかきりつくすかとのこるかたなくそむるもみちは",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "なか月とかねておもひしかひもなれおなしみそりにくるゝ秋哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "惜状",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "一神む月これも春たつ穴おからかすみもたゝす風もはけしき",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初冬",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "名にしおとゝ時雨はすともぬれしとてみかさの杜にさしてきにけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜時雨",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "苦むしろ青根かみねめ色かへて木々に木の葉をしく野哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "いつとほむほとをもしらす松の霜口をへてゑろき哉のあはれさ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霜",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "たかわけしあとゝもみへすくちし野に枯葉黒とろに妻まよふ也",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "長草",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "冬木度は氷やすらん誰かしる水屋の神と名にはき候とも",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "さむきこと宮こにまさる影そなきこし大洪水の月もみしかと",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬冴月",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "よをこめておほ浦風のあわねるね覚をいそく書鳴なり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一寝覚千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "いはのうへにあらぬもそする水鳥の如しの衣を家にかせとて",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水鳥",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "いく夜かは川せのあしろうつたへにいをぬぬ床にもりあかすらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "細代",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "たまあられふる音はかりすか原やふしみの竹のよるもねられす",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "竹霰",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "一かたにいとひもはてすあらはをしとはねはさひし雪の山里",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雪中弐人",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "鳥はなし今は一夜の潰やとやあるとつありこゑ計して帰るなり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鷹狩",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "一此神のこゝろはとけてしもむすら青柳葉をうたふ夜中かな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "神楽",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "もろ人の行としなみもいとなみもいとなくみへてさわくひかな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳願答",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "関書も有明まてはよもたへしわかかよひちまおもひたゝなん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄暁恋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "はてはまた雨にしくれむはしめそとあしたの雲をみをしらなん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄朝恋",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "せめてこの夕もまたてとはゝやとこゝろの馬のすゝむわかなき",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄昼恋",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "うき時をいつにかきると人とはゝ入共潰かねをきんとこたへむ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄夕恋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "夜を待とあはれとおもへせりてはとぬるか中なる契はかりに",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄夜恋",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "つれなきをいはんかたなき秋にあへは杜も下すゝころろふものを",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄木兵衛",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "なひきゝぬ心はいつかかはら屋のしたにたくひのこかれ侘ても",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄火応",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "土さけて照日なりとも晴かたき涙の袖やほさて朽な寂",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄土慈",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "あふ事のかたき契におもひにはま辺もつひにわくとこそれけ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄金庄衛",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "あふとなきわか井川になからしや妻ににけ水のそくひなるらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄水恋",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "紅濃やしほそむともあさしとやわかおもふひにくらへてはみむ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄水恋",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "いかて早くとしみそふらん玉たれ供すこしにおゝしなみの声にも",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一声声台",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "書とりねは人の残さぬうつり香をわか袖しきてなるゝかひなき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄香恋",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "しかすかにおもひはやます秋丈あまり心のもとしこゝろなれとも",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄心慈",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "いろそゝはいつるおもひは山なしの花にかけたる夕暮の雨",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄形恋",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "さま〳〵洗いは木はあれととこはの心をうつす庭の松か枝",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑十五首松作友",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "生れも今豊浦の鏡の風こしにきこえてふくる夜をやし声",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古寺鐘",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "みてそおもふあまりかりなる柴の庵はらき世に心のこす人かと",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "製漬しらすなてけるいはほとや苔のみとりの立ものほえぬ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "巌苔",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "なみたてる松はまつにて鳥砂やおほとし高きつかの諸こゑ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "名所鶴",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "世をかみて誰山かけにさらしけんたへぬうしのゝ滝のしら原",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秘",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "世の中もかくこそすまめ行とまる草の枕をやときためて",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅宿",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "いさなへるのへのまとゐのさか月も口かけも物にかたふきにけり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野遊日暮",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "舟はたをたゝけはあくる夜をしらて鮒とるならし志賀の蜑人",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "漁舟",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "あさに舟浦よりを大に猶まさるなかめやかると我にをしへに",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "眺望",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "つま木にはさかともきとし山人の本にやすめるひなりせは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "樵夫",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "気ふはかりうつゝとそみ昨日よりをちなる事はみな夢にして",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夢",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "道まもる此一ことのすみよし法神に手向ることのはとしれ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "述懐言画",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "なほもわかみし世はつらし聞し世をせめて哀と忍ふ計そ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "懐旧",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "いのかなるわか身はさても行末をたのむ子寺の神となるらん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733745",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄神祝",
   "kotobagaki": ""
  }
 ],
